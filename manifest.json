{
  "manifest_version": 3,
  "name": "New Tab Home ~/",
  "version": "1.0.1",
  "key": "",
  "description": "A new tab that is truly yours: your own wallpapers, a clock, and a search bar.",
  "permissions": ["search"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}

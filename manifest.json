{
  "manifest_version": 3,
  "name": "Helium New Tab",
  "version": "1.0.0",
  "description": "A custom New Tab page: clock, multi-engine search, and a wallpaper that rotates through a local image folder.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}

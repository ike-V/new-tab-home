pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--favicons
function _init()
 pal(9,137,1)
 pal(13,128,1)
end

-- icon i (0-9) with its top-left at x,y
-- each icon is a 2x2 block of sprites with 3px of margin
function icon(i,x,y)
 spr(2+2*(i%5)+32*(i\5),x-3,y-3,2,2)
end

function _draw()
 cls(2)
 spr(2,4,20,2,2)
 spr(4,28,20,2,2)
 spr(6,52,20,2,2)
 spr(8,76,20,2,2)
 spr(10,100,20,2,2)
 spr(34,4,52,2,2)
 spr(36,28,52,2,2)
 spr(38,52,52,2,2)
 spr(40,76,52,2,2)
 spr(42,100,52,2,2)
end
